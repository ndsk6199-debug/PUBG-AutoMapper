<Window x:Class="PubgAutoMapper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PUBG AutoMapper" Width="1100" Height="720" WindowStartupLocation="CenterScreen">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="PUBG AutoMapper" FontSize="30" FontWeight="Bold"/>
<Grid Grid.Row="1" Margin="0,18,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
<Border BorderBrush="#555" BorderThickness="1" CornerRadius="8" Padding="12"><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><Image x:Name="ScreenPreview" Stretch="Uniform" MouseLeftButtonDown="Screen_MouseLeftButtonDown"/></ScrollViewer></Border>
<StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="ADB / Calibration" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Margin="0,14,0,0" Text="Status: Waiting for Android device" TextWrapping="Wrap"/><TextBlock x:Name="ResolutionText" Margin="0,8,0,0" Text="Resolution: —"/><TextBlock x:Name="CoordinateText" Margin="0,8,0,0" Text="Coordinate inspector: —" TextWrapping="Wrap"/><Button x:Name="RefreshButton" Content="Detect + Capture" Width="170" Margin="0,18,0,0" Click="Refresh_Click"/><CheckBox x:Name="KeepNormalized" Content="Show normalized coordinates" IsChecked="True" Margin="0,14,0,8"/><TextBlock Text="Click any point on the captured phone screen to inspect its pixel and normalized coordinates." TextWrapping="Wrap" Margin="0,8,0,0"/><Separator Margin="0,18,0,12"/><TextBlock Text="Pipeline" FontWeight="SemiBold"/><TextBlock Text="1. ADB device ✓&#x0a;2. Screen capture ✓&#x0a;3. Coordinate inspector ✓&#x0a;4. HUD detector — next&#x0a;5. Profile generator — next" Margin="0,8,0,0"/></StackPanel></Grid>
<TextBlock Grid.Row="2" Text="Phase 1 • ADB + screen capture + coordinate calibration" Opacity="0.7"/></Grid></Window>