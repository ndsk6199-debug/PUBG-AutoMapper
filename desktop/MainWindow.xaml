<Window x:Class="PubgAutoMapper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PUBG AutoMapper" Width="1100" Height="720" WindowStartupLocation="CenterScreen">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="PUBG AutoMapper" FontSize="30" FontWeight="Bold"/>
<Grid Grid.Row="1" Margin="0,18,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
<Border BorderBrush="#555" BorderThickness="1" CornerRadius="8" Padding="12"><Grid><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><Image x:Name="ScreenPreview" Stretch="Uniform" SizeChanged="ScreenPreview_SizeChanged" MouseLeftButtonDown="Screen_MouseLeftButtonDown"/></ScrollViewer><Canvas x:Name="Overlay" IsHitTestVisible="False" Panel.ZIndex="10"/></Grid></Border>
<StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="Analyzer / Control Bridge" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Margin="0,14,0,0" Text="Status: Waiting for Android device" TextWrapping="Wrap"/><TextBlock x:Name="ResolutionText" Margin="0,8,0,0" Text="Resolution: —"/><TextBlock x:Name="CoordinateText" Margin="0,8,0,0" Text="Coordinate inspector: —" TextWrapping="Wrap"/><Button x:Name="RefreshButton" Content="Detect + Capture" Width="190" Margin="0,18,0,0" Click="Refresh_Click"/><Button x:Name="DetectHudButton" Content="Analyze HUD" Width="190" Margin="0,8,0,0" Click="DetectHud_Click" IsEnabled="False"/><Button x:Name="BridgeButton" Content="Connect Android Agent" Width="190" Margin="0,8,0,0" Click="Bridge_Click" IsEnabled="False"/><Button x:Name="TestTapButton" Content="Test Tap (center)" Width="190" Margin="0,8,0,0" Click="TestTap_Click" IsEnabled="False"/><Button x:Name="GenerateButton" Content="Generate profile JSON" Width="190" Margin="0,8,0,0" Click="Generate_Click" IsEnabled="False"/><CheckBox x:Name="KeepNormalized" Content="Show normalized coordinates" IsChecked="True" Margin="0,14,0,8"/><TextBlock Text="Detected controls" FontWeight="SemiBold" Margin="0,14,0,5"/><TextBox x:Name="ResultsText" Height="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Text="Pipeline" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="1. USB / ADB ✓&#x0a;2. Screen capture ✓&#x0a;3. Coordinate inspector ✓&#x0a;4. HUD detection ✓&#x0a;5. Overlay ✓&#x0a;6. JSON export ✓&#x0a;7. Android bridge ✓"/></StackPanel></Grid>
<TextBlock Grid.Row="2" Text="Phase 4 • Android gesture bridge + test controls" Opacity="0.7"/></Grid></Window>